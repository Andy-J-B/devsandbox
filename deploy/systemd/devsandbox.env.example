# DevSandbox systemd environment file.
#
# Install at /etc/devsandbox/devsandbox.env with mode 0600 and owner root.
# Every key that DevSandbox reads uses the DEVSANDBOX_ prefix; unrelated
# provider credentials in this file are ignored by DevSandbox settings.

# Required.  Generate with: openssl rand -hex 32
DEVSANDBOX_API_TOKEN=

# PostgreSQL coordinates.  Prefer a dedicated role/database and a password
# supplied through your platform's secret mechanism or a restricted env file.
DEVSANDBOX_DATABASE_URL=postgresql+asyncpg://devsandbox:devsandbox@localhost:5432/devsandbox

# Same absolute path the service user and the Docker daemon can both access.
DEVSANDBOX_DATA_ROOT=/var/lib/devsandbox

# Startup migrations are enabled by default and serialized with an advisory
# lock.  Disable only when `devsandbox init-db`/`db upgrade` is a separate
# deployment step.
# DEVSANDBOX_MIGRATIONS__AUTO_UPGRADE=true
# DEVSANDBOX_MIGRATIONS__LOCK_TIMEOUT_SECONDS=120

# Bind loopback and put a TLS proxy in front for remote access.
DEVSANDBOX_API__HOST=127.0.0.1
DEVSANDBOX_API__PORT=8000

# Pin agent/validator/proxy images by digest in production.
# DEVSANDBOX_AGENT__IMAGE=ghcr.io/example/devsandbox-agent@sha256:...
# DEVSANDBOX_VALIDATION__IMAGE=ghcr.io/example/devsandbox-validator@sha256:...
# DEVSANDBOX_SECURITY__REQUIRE_PINNED_IMAGES=true
